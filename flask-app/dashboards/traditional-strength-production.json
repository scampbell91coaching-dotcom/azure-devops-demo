{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "links": [
    {"title": "Application Insights (public availability, dependencies and traces)", "type": "link", "url": "https://portal.azure.com/#view/HubsExtension/BrowseResource/resourceType/microsoft.insights%2Fcomponents"},
    {"title": "Production runbook", "type": "link", "url": "https://github.com/scampbell91coaching-dotcom/azure-devops-demo/blob/main/docs/production-observability.md"}
  ],
  "panels": [
    {"type": "stat", "title": "Private scrape health", "id": 1, "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0}, "targets": [{"expr": "max(up{namespace=\"$namespace\",service=~\".*flask-app.*\"})", "legendFormat": "up"}], "fieldConfig": {"defaults": {"mappings": [{"options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}, "type": "value"}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []}},
    {"type": "stat", "title": "Ready replicas", "id": 2, "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0}, "targets": [{"expr": "kube_deployment_status_replicas_available{namespace=\"$namespace\",deployment=\"flask-web\"}", "legendFormat": "ready"}]},
    {"type": "stat", "title": "5xx rate", "id": 3, "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0}, "targets": [{"expr": "sum(rate(flask_http_requests_total{namespace=\"$namespace\",status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(flask_http_requests_total{namespace=\"$namespace\"}[5m])), 0.001)", "legendFormat": "5xx"}], "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.05}, {"color": "red", "value": 0.10}]}}, "overrides": []}},
    {"type": "stat", "title": "p95 latency", "id": 4, "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(flask_http_request_duration_seconds_bucket{namespace=\"$namespace\"}[10m])))", "legendFormat": "p95"}], "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 3}]}}, "overrides": []}},
    {"type": "timeseries", "title": "Request rate by status", "id": 5, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5}, "targets": [{"expr": "sum by (status_code) (rate(flask_http_requests_total{namespace=\"$namespace\"}[5m]))", "legendFormat": "{{status_code}}"}]},
    {"type": "timeseries", "title": "Latency percentiles", "id": 6, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5}, "targets": [{"expr": "histogram_quantile(0.50, sum by (le) (rate(flask_http_request_duration_seconds_bucket{namespace=\"$namespace\"}[10m])))", "legendFormat": "p50"}, {"expr": "histogram_quantile(0.95, sum by (le) (rate(flask_http_request_duration_seconds_bucket{namespace=\"$namespace\"}[10m])))", "legendFormat": "p95"}, {"expr": "histogram_quantile(0.99, sum by (le) (rate(flask_http_request_duration_seconds_bucket{namespace=\"$namespace\"}[10m])))", "legendFormat": "p99"}], "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}},
    {"type": "timeseries", "title": "Pod restarts", "id": 7, "gridPos": {"h": 8, "w": 8, "x": 0, "y": 13}, "targets": [{"expr": "increase(kube_pod_container_status_restarts_total{namespace=\"$namespace\",pod=~\"flask-web.*\"}[15m])", "legendFormat": "{{pod}}"}]},
    {"type": "timeseries", "title": "CPU / limit", "id": 8, "gridPos": {"h": 8, "w": 8, "x": 8, "y": 13}, "targets": [{"expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"$namespace\",pod=~\"flask-web.*\",container!=\"\"}[5m])) / clamp_min(sum by (pod) (kube_pod_container_resource_limits{namespace=\"$namespace\",pod=~\"flask-web.*\",resource=\"cpu\"}), 0.001)", "legendFormat": "{{pod}}"}], "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []}},
    {"type": "timeseries", "title": "Memory / limit", "id": 9, "gridPos": {"h": 8, "w": 8, "x": 16, "y": 13}, "targets": [{"expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"$namespace\",pod=~\"flask-web.*\",container!=\"\"}) / clamp_min(sum by (pod) (kube_pod_container_resource_limits{namespace=\"$namespace\",pod=~\"flask-web.*\",resource=\"memory\"}), 1)", "legendFormat": "{{pod}}"}], "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []}},
    {"type": "table", "title": "Failed migration, worker and batch Jobs", "id": 10, "gridPos": {"h": 7, "w": 24, "x": 0, "y": 21}, "targets": [{"expr": "kube_job_status_failed{namespace=\"$namespace\",job_name=~\".*(migrat|worker|traditional-strength|flask).*\"} > 0", "format": "table", "instant": true}]},
    {"type": "stat", "title": "Database ready", "id": 11, "gridPos": {"h": 5, "w": 6, "x": 0, "y": 28}, "targets": [{"expr": "min(traditional_strength_dependency_available{namespace=\"$namespace\",dependency=\"database\"})", "legendFormat": "database"}]},
    {"type": "timeseries", "title": "Login failures", "id": 12, "gridPos": {"h": 7, "w": 9, "x": 6, "y": 28}, "targets": [{"expr": "sum by (outcome) (increase(traditional_strength_auth_events_total{namespace=\"$namespace\",event=\"login\",outcome=~\"failed|rate_limited\"}[10m]))", "legendFormat": "{{outcome}}"}]},
    {"type": "timeseries", "title": "Tenant access denials", "id": 13, "gridPos": {"h": 7, "w": 9, "x": 15, "y": 28}, "targets": [{"expr": "sum by (reason) (increase(traditional_strength_tenant_access_denials_total{namespace=\"$namespace\"}[15m]))", "legendFormat": "{{reason}}"}]},
    {"type": "stat", "title": "Status collector age", "id": 14, "gridPos": {"h": 5, "w": 6, "x": 0, "y": 33}, "targets": [{"expr": "time() - kube_cronjob_status_last_successful_time{namespace=\"$namespace\",cronjob=\"platform-status-collector\"}", "legendFormat": "seconds"}], "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 900}]}}, "overrides": []}}
  ],
  "schemaVersion": 39,
  "tags": ["traditional-strength", "production", "owned-platform"],
  "templating": {"list": [{"name": "namespace", "type": "constant", "query": "production", "current": {"text": "production", "value": "production"}}]},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "Traditional Strength / Production Health",
  "uid": "traditional-strength-production",
  "version": 1
}
