{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traditionalstrength.example/schemas/credential-metadata-1.0.json",
  "title": "Traditional Strength credential metadata manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "credentials"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "credentials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "owner", "last_verified", "storage_location", "rotation_status"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "last_verified": {"type": "string", "format": "date"},
          "storage_location": {
            "type": "string",
            "minLength": 1,
            "description": "Canonical inventory location or an unverified non-inventory location. GitHub environment names are RFC 3986 percent-encoded.",
            "examples": [
              "github-actions:repository:DEPLOY_TOKEN",
              "github-actions:environment:prod%2Feu:AZURE_ID",
              "azure-key-vault:00000000-0000-0000-0000-000000000001:rg-production:kv-production:app-database-url"
            ]
          },
          "rotation_status": {"enum": ["current", "due", "required", "unknown"]}
        }
      }
    }
  }
}
